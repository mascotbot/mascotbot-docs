{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Mascotbot Documentation",
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "css": "/custom.css",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Documentation",
        "icon": "book",
        "description": "Get started with Mascotbot",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "overview",
              "installation",
              "quickstart"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/visemes-and-timeline",
              "concepts/rive-coexistence",
              "concepts/licensing-and-keys"
            ]
          },
          {
            "group": "React SDK",
            "icon": "react",
            "pages": [
              "libraries/react-sdk",
              "libraries/react-hooks",
              "libraries/streaming-and-mic",
              "libraries/offline-lipsync",
              "libraries/natural-lip-sync"
            ]
          },
          {
            "group": "Core SDK (vanilla)",
            "pages": [
              "core/client",
              "core/streaming",
              "core/pcm-stream-player"
            ]
          },
          {
            "group": "Realtime providers",
            "pages": [
              "realtime/overview",
              "libraries/elevenlabs-avatar",
              "libraries/gemini-live-api-avatar",
              "libraries/openai-realtime-api-avatar"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/error-codes",
              "reference/api-conventions",
              "reference/migration",
              "libraries/react-troubleshooting"
            ]
          },
          {
            "group": "Ready-made Mascots",
            "pages": [
              "mascots/ready-to-use-mascots"
            ]
          }
        ]
      },
      {
        "dropdown": "Changelog",
        "icon": "rectangle-history",
        "description": "Product updates and release notes",
        "groups": [
          {
            "group": "Latest",
            "pages": [
              "changelog"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Follow us on X",
          "href": "https://x.com/mascot_bots",
          "icon": "megaphone"
        }
      ]
    }
  },
  "redirects": [
    { "source": "/libraries/react-native-sdk", "destination": "/overview" },
    { "source": "/libraries/react-native-troubleshooting", "destination": "/libraries/react-troubleshooting" },
    { "source": "/api-reference", "destination": "/overview" },
    { "source": "/api-reference/introduction", "destination": "/overview" },
    { "source": "/api-reference/endpoint/post", "destination": "/core/client" },
    { "source": "/api-reference/endpoint/visemes-audio", "destination": "/core/client" },
    { "source": "/api-reference/endpoint/get-signed-url", "destination": "/realtime/overview" },
    { "source": "/api-reference/endpoint/gemini-live-api", "destination": "/realtime/overview" },
    { "source": "/api-reference/lipsync-integration", "destination": "/realtime/overview" },
    { "source": "/libraries/prefetching-advanced-control", "destination": "/libraries/offline-lipsync" },
    { "source": "/libraries/ephemeral-token-security-model", "destination": "/concepts/licensing-and-keys" }
  ],
  "logo": {
    "light": "/logo/mascotbot_logo_dark.svg",
    "dark": "/logo/mascotbot_logo_light.svg",
    "href": "https://mascot.bot"
  },
  "navbar": {
    "links": [
      {
        "label": "Support and Feedback",
        "href": "mailto:support@mascot.bot"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Main Website",
      "href": "https://mascot.bot"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mascot_bots"
    }
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "og:site_name": "Mascot Bot SDK Documentation",
      "og:image": "https://mascotbot-app.s3.amazonaws.com/rive-assets/og_assets/mascotbot_og.png",
      "og:locale": "en_US",
      "twitter:card": "summary_large_image",
      "twitter:site": "@mascot_bots",
      "description": "Add AI-powered animated mascots with real-time lip sync to your applications. React SDK documentation for voice avatars and conversational AI.",
      "keywords": "mascot bot, AI avatar, voice avatar SDK, lip sync, conversational AI, React SDK, ElevenLabs integration, ElevenLabs companion, animated characters",
      "author": "Mascot Bot",
      "robots": "index, follow",
      "language": "en",
      "viewport": "width=device-width, initial-scale=1.0",
      "theme-color": "#000000"
    }
  }
}
